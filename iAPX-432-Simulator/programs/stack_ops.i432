# stack_ops.i432 - Stack Operations Demo
# Demonstrates push, pop, arithmetic on the operand stack

# Push some values
PUSH 10         # Push 10
PUSH 20         # Push 20
PUSH 30         # Push 30

# Arithmetic operations
ADD             # 10 + 20 = 30, stack: [30, 30]
SUB             # 30 - 30 = 0, stack: [0]
PUSH 5          # Push 5
PUSH 3          # Push 3
MUL             # 5 * 3 = 15, stack: [0, 15]
ADD             # 0 + 15 = 15, stack: [15]

# Bitwise operations
PUSH 0xFF       # Push 255
AND             # 15 & 255 = 15
PUSH 0xF0       # Push 240
OR              # 15 | 240 = 255
PUSH 0x0F       # Push 15
XOR             # 255 ^ 15 = 240

# Conditional operations
PUSH 0          # Push 0 (false)
PUSH 1          # Push 1 (true)
COMPARE         # Compare 0 and 1, result: -1 (negative)
BRANCHNE SKIP   # Branch if not equal (will branch)
PUSH 999        # This is skipped
SKIP:
    PUSH 42     # Push 42

HALT            # Stop
